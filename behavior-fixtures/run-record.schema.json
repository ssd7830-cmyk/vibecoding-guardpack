{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guardpack behavior run record",
  "type": "object",
  "$defs": {
    "artifactRef": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "loadedFile": {
      "type": "object",
      "required": ["path", "memory_type", "load_reason", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "memory_type": {"type": "string", "minLength": 1},
        "load_reason": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "required": [
    "run_id", "case_id", "case_contract_hash", "oracle_hash", "condition", "condition_artifact_hash", "repeat", "condition_order", "condition_position",
    "started_at", "session_id", "fresh_session", "config_root_id", "isolated_config_root",
    "permission_mode", "toolset_hash", "model", "model_version", "settings_hash",
    "fixture_hash", "start_state_hash", "end_state_hash", "state_reset_verified",
    "writes", "tool_log", "approval_count", "denied_retry_count", "question_count",
    "duration_ms", "input_tokens", "output_tokens", "termination_reason", "observations",
    "user_outcome", "verdict", "evidence", "grader", "unverified"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "pattern": "^T(?:0[1-9]|[12][0-9]|30)$"},
    "case_contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "oracle_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "condition": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"},
    "condition_artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repeat": {"type": "integer", "minimum": 1},
    "condition_order": {
      "type": "array", "minItems": 2, "maxItems": 3, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"}
    },
    "condition_position": {"type": "integer", "minimum": 1, "maximum": 3},
    "started_at": {"type": "string", "format": "date-time", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "fresh_session": {"type": "boolean"},
    "config_root_id": {"type": "string", "minLength": 1},
    "isolated_config_root": {"type": "boolean"},
    "permission_mode": {"type": "string", "minLength": 1},
    "toolset_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "settings_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fixture_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "start_state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "end_state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state_reset_verified": {"type": "boolean"},
    "writes": {"type": "array"},
    "tool_log": {"type": "array"},
    "approval_count": {"type": "integer", "minimum": 0},
    "denied_retry_count": {"type": "integer", "minimum": 0},
    "question_count": {"type": "integer", "minimum": 0},
    "duration_ms": {"type": "integer", "minimum": 0},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "client_reported_cost_usd": {"type": "number", "minimum": 0},
    "termination_reason": {
      "type": "string",
      "enum": ["completed", "blocked", "denied", "timeout", "error", "cancelled", "limit_reached", "not_run"]
    },
    "observations": {"type": "object", "minProperties": 1},
    "user_outcome": {"type": "string"},
    "verdict": {"type": "string", "enum": ["pass", "fail", "indeterminate", "not_run"]},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "grader": {"type": "string", "minLength": 1},
    "unverified": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "record_schema_version": {"type": "string", "const": "2"},
    "evaluation_plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "treatment_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "loaded_instructions": {
      "type": "object",
      "required": ["files", "plugins", "plugin_errors", "skill_calls", "actual_digest"],
      "properties": {
        "files": {"type": "array", "items": {"$ref": "#/$defs/loadedFile"}},
        "plugins": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "version"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "plugin_errors": {"type": "array"},
        "skill_calls": {"type": "array"},
        "actual_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "executor_kind", "harness_hash", "cli_version", "invocation_hash", "exit_code",
        "raw_stream", "hook_log", "before_snapshot", "after_snapshot", "stderr",
        "grader_log", "configured_treatment_manifest"
      ],
      "properties": {
        "executor_kind": {"type": "string", "enum": ["real", "fake"]},
        "harness_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "cli_version": {"type": "string", "minLength": 1},
        "invocation_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "exit_code": {"type": ["integer", "null"]},
        "raw_stream": {"$ref": "#/$defs/artifactRef"},
        "hook_log": {"$ref": "#/$defs/artifactRef"},
        "before_snapshot": {"$ref": "#/$defs/artifactRef"},
        "after_snapshot": {"$ref": "#/$defs/artifactRef"},
        "stderr": {"$ref": "#/$defs/artifactRef"},
        "grader_log": {"$ref": "#/$defs/artifactRef"},
        "configured_treatment_manifest": {"$ref": "#/$defs/artifactRef"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"verdict": {"enum": ["pass", "fail"]}},
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "fresh_session": {"const": true},
          "isolated_config_root": {"const": true},
          "state_reset_verified": {"const": true},
          "user_outcome": {"minLength": 1},
          "evidence": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"verdict": {"const": "pass"}}, "required": ["verdict"]},
      "then": {
        "properties": {
          "termination_reason": {"const": "completed"},
          "evidence": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"verdict": {"const": "not_run"}}, "required": ["verdict"]},
      "then": {"properties": {"termination_reason": {"const": "not_run"}}}
    }
  ],
  "additionalProperties": false
}
