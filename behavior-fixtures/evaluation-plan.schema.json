{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guardpack preregistered behavior evaluation plan",
  "type": "object",
  "required": [
    "schema_version", "plan_id", "created_at", "oracle_hash", "conditions",
    "repeats", "controls", "treatments", "cases", "schedule", "stop_rule"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1"},
    "plan_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "oracle_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "conditions": {
      "const": ["no_pack", "full_pack"]
    },
    "repeats": {"const": 3},
    "controls": {
      "type": "object",
      "required": [
        "cli_version", "model", "model_version", "effort", "permission_mode",
        "max_turns", "timeout_seconds", "per_run_budget_usd", "toolset_hash", "settings_hash",
        "grader", "grader_hash", "harness_hash"
      ],
      "properties": {
        "cli_version": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "model_version": {"type": "string", "minLength": 1},
        "effort": {"type": "string", "minLength": 1},
        "permission_mode": {"type": "string", "minLength": 1},
        "max_turns": {"type": "integer", "minimum": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "per_run_budget_usd": {"type": "number", "exclusiveMinimum": 0},
        "toolset_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "settings_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "grader": {"type": "string", "minLength": 1},
        "grader_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "harness_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "treatments": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 2,
      "additionalProperties": {"$ref": "#/$defs/treatment"}
    },
    "cases": {
      "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true,
      "items": {"$ref": "#/$defs/case"}
    },
    "schedule": {
      "type": "array", "minItems": 42, "maxItems": 42, "uniqueItems": true,
      "items": {"$ref": "#/$defs/scheduleCell"}
    },
    "stop_rule": {
      "type": "object",
      "required": ["type", "retain_all_outcomes"],
      "properties": {
        "type": {"const": "fixed_matrix"},
        "retain_all_outcomes": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "instruction": {
      "type": "object",
      "required": ["path", "sha256", "load"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "load": {"type": "string", "enum": ["required", "allowed_lazy"]}
      },
      "additionalProperties": false
    },
    "plugin": {
      "type": "object",
      "required": ["name", "version", "manifest_path", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "manifest_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "treatment": {
      "type": "object",
      "required": ["condition", "configured_manifest_hash", "manifest"],
      "properties": {
        "condition": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"},
        "configured_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest": {
          "type": "object",
          "required": ["instructions", "plugins"],
          "properties": {
            "instructions": {"type": "array", "items": {"$ref": "#/$defs/instruction"}},
            "plugins": {"type": "array", "items": {"$ref": "#/$defs/plugin"}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": [
        "case_id", "case_contract_hash", "fixture_hash", "start_state_hash",
        "grader_contract_hash"
      ],
      "properties": {
        "case_id": {"type": "string", "pattern": "^T(?:0[1-9]|[12][0-9]|30)$"},
        "case_contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fixture_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "start_state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "grader_contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "scheduleCell": {
      "type": "object",
      "required": ["case_id", "repeat", "condition", "condition_position"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^T(?:0[1-9]|[12][0-9]|30)$"},
        "repeat": {"type": "integer", "minimum": 1},
        "condition": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"},
        "condition_position": {"type": "integer", "minimum": 1, "maximum": 2}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
